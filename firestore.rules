rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users ────────────────────────────────────────────────
    match /users/{userId} {
      // User can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;

      // User can create their own profile (on signup)
      allow create: if request.auth != null && request.auth.uid == userId;

      // User can update their own profile (limited fields)
      allow update: if request.auth != null && request.auth.uid == userId
        && onlyUserFieldsUpdate();

      // No delete allowed
      allow delete: if false;

      function onlyUserFieldsUpdate() {
        let allowedFields = [
          'displayName', 'photoUrl', 'npCoins', 'totalWins', 'totalLosses',
          'tickets', 'dailyAdsWatched', 'lastAdWatchDate', 'checkInDay',
          'lastCheckInDate', 'dailyTicketsEarned', 'lastResetDate',
          'currentTicketUsage', 'todayMatchesPlayed', 'todayCoinsEarned',
          'lastPlayDate', 'processedMatchIds', 'createdAt', 'username', 'email', 'uid'
        ];
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        return changedKeys.hasOnly(allowedFields);
      }
    }

    // ─── Matches ──────────────────────────────────────────────
    match /matches/{matchId} {
      // Both players can read match data
      allow read: if request.auth != null
        && (resource.data.player1Id == request.auth.uid
          || resource.data.player2Id == request.auth.uid);

      // Server creates matches (admin SDK), players cannot write directly
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ─── Redemptions ──────────────────────────────────────────
    match /redemptions/{redemptionId} {
      // User can read their own redemptions
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // User can create a redemption request
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING';

      // No update/delete by user (admin handles)
      allow update: if false;
      allow delete: if false;
    }

    // ─── Daily Leaderboard (read-only for users) ──────────────
    match /leaderboards/{dateId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
